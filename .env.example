# ================================
# ElektroniKu - Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya
# ================================

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=elektroniku

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# Redis
REDIS_PASSWORD=changeme

# Backend
PORT=5000
MONGO_URI=mongodb://admin:changeme@mongodb:27017/elektroniku?authSource=admin
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=products
OLLAMA_API_URL=https://your-ollama-endpoint/api/generate
OLLAMA_MODEL=llama3
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-unik
REDIS_URL=redis://:changeme@redis:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_NAME=ElektroniKu
NEXT_PUBLIC_MINIO_URL=http://localhost:9000/products

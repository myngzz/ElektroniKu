{
  "name": "elektroniku-backend",
  "version": "1.0.0",
  "description": "ElektroniKu Backend API - Katalog Produk Elektronik",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
